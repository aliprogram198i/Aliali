{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "python -m pip install --target /app/vendor ."
  },
  "deploy": {
    "startCommand": "PYTHONPATH=/app/vendor:/app/src python -m uvicorn aliali.api.server:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
